# Template for .env.override — copy it, then fill in the real values:
#
#   cp .env.override.example .env.override
#
# .env.override is gitignored and is loaded LAST, so everything here overrides
# .env without editing it. The Makefile picks it up automatically when it
# exists (see DOCKER_COMPOSE_ENV), so `make build && make start` is all you need.
#
# This file is the ONLY place org-specific values should live. Switching the
# stack between OpsPilot orgs must never mean editing any other file.
#
# NEVER commit .env.override. Never paste real values into this template.

# ----------------------------------------------------------------------------
# OpsPilot destination  (required — the collector will not start without these)
# ----------------------------------------------------------------------------
# Base URL of the OpsPilot ingest endpoint, no trailing slash. The collector
# appends /otlp for metrics and /loki/api/v1/push for logs itself, so put only
# the scheme and host here.
#   src/otel-collector/otelcol-config.yml exporters: otlphttp,
#   otlphttp/prometheus, loki
OPSPILOT_ENDPOINT=https://REPLACE-ME.example.com

# Value of the `authorization` header sent on all three exporters. Copy it
# exactly as OpsPilot gives it to you, including any scheme prefix.
OPSPILOT_AUTH=REPLACE-ME

# ----------------------------------------------------------------------------
# Resource attributes
# ----------------------------------------------------------------------------
# Same as .env plus deployment.environment, which is what marks this data as the
# webinar demo and what the Step 6 alert rules group on. Keep service.namespace
# and service.version byte-identical to .env so the OpsPilot Service Catalogue
# does not split.
OTEL_RESOURCE_ATTRIBUTES=service.namespace=opentelemetry-demo,service.version=${IMAGE_VERSION},deployment.environment=webinar-demo

# ----------------------------------------------------------------------------
# macOS: keep the collector out of protected folders
# ----------------------------------------------------------------------------
# Upstream mounts the whole host root at /hostfs for the hostmetrics receiver,
# which on macOS makes Docker Desktop raise privacy prompts for ~/Documents,
# ~/Desktop and ~/Downloads. Point it at the empty stub directory instead; the
# cpu/memory/load/network/paging scrapers are unaffected because they read
# /proc. On Linux you can drop this line and keep the upstream HOST_FILESYSTEM=/.
HOST_FILESYSTEM=./.hostfs-stub

# ----------------------------------------------------------------------------
# Bugsnag — blanked for the webinar
# ----------------------------------------------------------------------------
# .env ships live Bugsnag keys for email, payment and quote. Empty values stop
# those three services shipping errors off the machine during the demo:
# src/payment/index.js and src/quote-cf/www/Application.cfc both skip Bugsnag
# initialisation when the key is empty.
BUGSNAG_API_KEY=
BUGSNAG_EMAIL_API_KEY=
BUGSNAG_PAYMENT_API_KEY=

# ----------------------------------------------------------------------------
# FusionReactor agents on ad, fraud-detection and quote
# ----------------------------------------------------------------------------
# All three run the FR 2026.1.0-SNAPSHOT agent with no licence and no cloud
# configuration, so they currently report nowhere. FR takes these as JVM system
# properties, not as agent arguments, so setting the variables below appends the
# matching -D flags to JAVA_TOOL_OPTIONS (ad, fraud-detection) and
# LUCEE_JAVA_OPTS (quote) in docker-compose.yml.
#
# Each group is added only when its variable is set. With all of them empty the
# option strings are byte-identical to the ones baked into each Dockerfile, so
# nothing changes until you fill these in.
#
# The FR instance names (otlp-ad-fr, otlp-fraud-detection-fr,
# quote-service-lucee) are deliberately NOT configurable: OpsPilot's Service
# Catalogue history depends on them staying stable.

# FusionReactor licence key. When set, adds:
#   -Dfrlicense=<value> -Dfr.license.endpoint=<FR_LICENSE_ENDPOINT>
FR_LICENSE=

# FR Cloud group to report into. ORG-SPECIFIC - this must differ between
# EmmettDev and the FR demo org. When set, adds:
#   -Dfr.cloud.group=<value> -Dfr.cloud.endpoint=<FR_CLOUD_ENDPOINT>
FR_CLOUD_GROUP=

# Endpoints. The defaults below are applied automatically, so leave these unset
# unless FR Cloud ever needs pointing elsewhere (a different region, say).
#   FR_LICENSE_ENDPOINT default: https://api.fusionreactor.io/licensing-api/
#   FR_CLOUD_ENDPOINT   default: https://api.fusionreactor.io
# FR_LICENSE_ENDPOINT=
# FR_CLOUD_ENDPOINT=

# Escape hatch for extra FR AGENT arguments (not -D properties), appended to the
# -javaagent option string verbatim. Must start with a comma, e.g.
#   FR_AGENT_OPTS=,someoption=1
FR_AGENT_OPTS=

# ----------------------------------------------------------------------------
# Coworker deployment events  (optional)
# ----------------------------------------------------------------------------
# ORG-SPECIFIC. The webhook URL of a Coworker "Generic Webhook" event source,
# which `./demo.sh deploy-bad` and `./demo.sh rollback` POST a deployment event
# to. Without it Coworker sees the new service.version on the spans but has no
# deploy event to link a Situation to, so it will not connect the symptom to
# the release.
#
# Create it in the OpsPilot UI: new Coworker thread -> "Set up a task" -> ask
# for a Generic Webhook event source. See "Manual OpsPilot UI steps" in
# docs/CHANGES-FOR-FR-DEMO.md.
#
# TREAT AS A SECRET: the URL embeds its own token, so anyone holding it can
# start investigations in the org. demo.sh never prints it.
#
# Leave unset and demo.sh simply skips that sink; the OTLP deployment log it
# sends through the collector is unaffected.
OPSPILOT_DEPLOY_WEBHOOK=
